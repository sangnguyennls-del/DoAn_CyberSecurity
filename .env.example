# Copy sang .env roi dien gia tri that. KHONG commit file .env.

# Provider mac dinh: claude | deepseek
AI_PROVIDER=claude

# Chi can key cua provider ban dung (dien ca hai neu muon so sanh)
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

# Doi model neu muon. DeepSeek: deepseek-v4-pro (tot hon) | deepseek-flash (re hon)
# CLAUDE_MODEL=claude-opus-5
# DEEPSEEK_MODEL=deepseek-v4-pro

# Chi can khi dung --profile auth (quet co dang nhap).
# Tao mot tai khoan tren CHINH target lab cua ban roi dien vao day.
ZAP_AUTH_USER=
ZAP_AUTH_PASS=

# Mac dinh cau hinh cho Juice Shop. Target khac thi de len:
# ZAP_LOGIN_URL=http://host.docker.internal:3000/rest/user/login
# ZAP_LOGIN_BODY={"email":"{%username%}","password":"{%password%}"}
# ZAP_AUTH_CHECK_PATH=/api/Cards
